# ---------------------------------------------------------------------------
# .env UNICO do projeto — copie para `.env` NA RAIZ (nao em backend/).
#
#   raiz/.env  ->  lido pelo Nest (envFilePath: ['.env', '../.env']),
#                  pela CLI do Prisma (scripts npm com dotenv -e ../.env)
#                  e pelo docker compose (env_file).
#
# Os valores marcados com (=) PRECISAM ser identicos aos do sistema Python que
# roda hoje em producao, senao tokens e senhas param de funcionar.
#
# Use quebra de linha LF. Com CRLF o docker compose injeta um \r no fim de cada
# valor e o JWT_SECRET/senha do MySQL passam a nao bater.
# ---------------------------------------------------------------------------

NODE_ENV=development
# Porta interna do Nest — deve ser a mesma no healthcheck (Dockerfile) e no
# Traefik (docker-compose.yml). Skill de deploy usa 3000; local pode ser 8000.
PORT=8000

# MySQL (=) — mesmas credenciais do backend/.env
MYSQL_HOST=mysql_shared
MYSQL_PORT=3306
MYSQL_DATABASE=financeiro
MYSQL_USER=financeiro_user
MYSQL_PASSWORD=troque_esta_senha

# DATABASE_URL — OBRIGATORIA. A aplicacao monta a URL sozinha a partir das
# MYSQL_* acima, mas a CLI do Prisma (db pull, migrate, generate) nao executa o
# codigo da aplicacao: ela le esta variavel. Sem a linha abaixo, todo comando
# do Prisma aborta com "Environment variable not found: DATABASE_URL".
# O `setup.sh` preenche esta linha usando o mesmo URL-encoding do quote_plus
# (backend/scripts/database-url.mjs).
DATABASE_URL=mysql://user:pass@host:3306/financeiro?charset=utf8mb4

# Seguranca / JWT (=) — MESMO SEGREDO do Python, senao todo mundo desloga.
#
# USE ASPAS SIMPLES se o valor tiver `#`, espaco ou `$`. O dotenv do Node trata
# `#` como inicio de comentario em valor sem aspas e CORTA o resto; o
# python-dotenv nao corta. Sem aspas, Python e Node leem segredos diferentes e
# os tokens ja emitidos deixam de valer.
JWT_SECRET='troque-este-valor-por-uma-chave-aleatoria-longa'
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REMEMBER_ME_EXPIRE_MINUTES=43200

# Administrador unico (seed no primeiro startup)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@financeiro.com.br
ADMIN_PASSWORD=Admin@123

# Regras de dominio (=)
EMAIL_DOMAIN=@financeiro.com.br
PASSWORD_RESET_EXPIRE_MINUTES=30

# SMTP (opcional). Sem isso o link de reset aparece no painel admin e no log.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=nao-responda@financeiro.com.br
SMTP_TLS=true

# Base publica usada para montar o link de reset.
# DOMAIN alimenta as regras Host() do Traefik no docker-compose.yml
# (frontend em ${DOMAIN}, API em api.${DOMAIN}).
DOMAIN=
APP_BASE_URL=http://localhost:8000

# Traefik (so usados pelo docker-compose.yml)
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# CORS — origens explicitas separadas por virgula.
# NAO use "*" (ver plano, secao 6.3: wildcard + credentials e invalido).
# Dev local: http://localhost:5173
# Producao (Docker): https://SEU_DOMINIO (mesmo valor de DOMAIN, com https)
CORS_ORIGINS=http://localhost:5173
