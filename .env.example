# Ambiente de execucao:
# - production  -> Docker/VPS, com build pronto e sem modo de desenvolvimento.
# - development -> somente trabalho local com `npm run start:dev` / `npm run dev`.
# Para deploy, mantenha production.
NODE_ENV=production
# Porta interna do Nest — deve ser a mesma no healthcheck (Dockerfile) e no
# Traefik (docker-compose.yml). Skill de deploy usa 3000; local pode ser 8000.
PORT=8000

# MySQL (=) — mesmas credenciais do backend/.env
MYSQL_HOST=mysql_shared
MYSQL_PORT=3306
MYSQL_DATABASE=financeiro
MYSQL_USER=financeiro_user
MYSQL_PASSWORD=ALTERE_AQUI

# Calculada automaticamente a partir das MYSQL_* pelo setup.sh e, como
# protecao adicional, pelo prisma.config.ts. Nao precisa preencher manualmente.
DATABASE_URL=

# Seguranca / JWT (=) — MESMO SEGREDO do Python, senao todo mundo desloga.
#
# USE ASPAS SIMPLES se o valor tiver `#`, espaco ou `$`. O dotenv do Node trata
# `#` como inicio de comentario em valor sem aspas e CORTA o resto; o
# python-dotenv nao corta. Sem aspas, Python e Node leem segredos diferentes e
# os tokens ja emitidos deixam de valer.
JWT_SECRET='ALTERE_AQUI_por_uma_chave_aleatoria_com_32_ou_mais_caracteres'
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REMEMBER_ME_EXPIRE_MINUTES=43200

# Administrador unico (seed no primeiro startup)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@exemplo.com.br
ADMIN_PASSWORD=ALTERE_AQUI

# Regras de dominio (=)
EMAIL_DOMAIN=@exemplo.com.br
PASSWORD_RESET_EXPIRE_MINUTES=30

# SMTP (opcional). Sem isso o link de reset aparece no painel admin e no log.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=nao-responda@exemplo.com.br
SMTP_TLS=true

# Base publica usada para montar o link de reset.
# DOMAIN alimenta as regras Host() do Traefik no docker-compose.yml
# (frontend em ${DOMAIN}, API em api.${DOMAIN}).
DOMAIN=financeiro.exemplo.com.br
# Vazio = o backend deriva https://${DOMAIN}.
APP_BASE_URL=

# Traefik (so usados pelo docker-compose.yml)
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# CORS — origens explicitas separadas por virgula.
# NAO use "*" (ver plano, secao 6.3: wildcard + credentials e invalido).
# Para desenvolvimento local, troque temporariamente por http://localhost:5173.
CORS_ORIGINS=https://financeiro.exemplo.com.br
